{
  "name": "planplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "dotenv -e .env.development -- prisma validate",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "db:baseline:production": "dotenv -e .env.production -- prisma migrate resolve --applied 20260902000000_initial_schema",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "db:seed:production": "dotenv -e .env.production -- prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "daisyui": "^4.12.13",
    "lottie-web": "^5.13.0",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.3.0",
    "react-toastify": "^11.0.2",
    "recharts": "^2.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.26",
    "prettier": "^3.6.2",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "description": "A gamified task manager built with Next.js, PostgreSQL, and Prisma.",
  "license": "ISC",
  "overrides": {
    "postcss": "8.5.26",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
